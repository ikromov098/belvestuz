# Server-side only. Set these in Vercel (Production and Preview) and in .env.local for development.
# Never use a NEXT_PUBLIC_ prefix for any of them.

# Telegram group notifications (existing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Website chatbot (DeepSeek, replaces Anthropic)
DEEPSEEK_API_KEY=

# Belvest core: leads from the callback widget and /apply also go to the dashboard.
# Both optional; when either is empty the lead goes to Telegram only.
BELVEST_CORE_URL=https://app.belvest.uz
BELVEST_LANDING_TOKEN=
